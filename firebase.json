{
 "hosting": {
  "site": "umichaiaa",
  "public": "dist",
  "headers": [
   {
    "source": "**/*.html",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "public, max-age=0, must-revalidate"
     }
    ]
   },
   {
    "source": "**/*.@(css|js|png|svg|ico|jpg)",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "public, max-age=86400"
     }
    ]
   },
   {
    "source": "/admin/**",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-store"
     },
     {
      "key": "X-Robots-Tag",
      "value": "noindex, nofollow"
     }
    ]
   }
  ]
 },
 "firestore": {
  "rules": "firestore.rules"
 }
}
