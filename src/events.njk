---
layout: layout.njk
permalink: /events.html
title: "Michigan AIAA: Events"
pageKey: events
css: /assets-events/events.css
bodyClass: homepage subpage
navCurrent: events
eleventyComputed:
  heroImageUrl: "{{ events.heroImage | safe }}"
gallery: ["t_panel","t_talk","t_tabling"]
---
<div id="main-wrapper">
					<div class="wrapper style2">
						<div class="inner">
							<div class="container">
								<div class="row">
									<div class="col-4 col-12-medium">
										<div id="sidebar">

											<!-- Sidebar -->

												<section>
													<header class="major">
														<h2>{{ events.socialHeading }}</h2>
													</header>
													<div id="fb-embed" class="fb-embed" data-page="https://www.facebook.com/AIAAatUMICH"></div>
<p class="fb-open"><a class="join-btn" href="https://www.facebook.com/AIAAatUMICH" target="_blank" rel="noopener">Open on Facebook <span aria-hidden="true">&rarr;</span></a></p>
<script>
(function () {
  var box = document.getElementById("fb-embed");
  function build() {
    var w = Math.max(280, Math.min(500, Math.floor(box.clientWidth || 340)));
    var src = "https://www.facebook.com/plugins/page.php?href=" + encodeURIComponent(box.dataset.page) +
      "&tabs=timeline&width=" + w + "&height=720&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true";
    box.innerHTML = '<iframe title="Michigan AIAA on Facebook" src="' + src + '" width="' + w + '" height="720" style="border:0;overflow:hidden;max-width:100%" scrolling="no" frameborder="0" allowfullscreen="true" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share" loading="lazy"></iframe>';
  }
  build();
})();
</script>
												</section>

										</div>
									</div>
									<div class="col-8 col-12-medium imp-medium">
										<div id="content">

											<!-- Content -->

												<article>
													<header class="major">
														<h2>{{ events.calendarHeading }}</h2>
													</header>
													<iframe src="https://calendar.google.com/calendar/embed?src={{ events.calendarEmail | urlencode }}&ctz=America%2FDetroit&mode=MONTH&showTitle=0&showPrint=0&showTz=0" style="border:0;width:100%;max-width:900px;height:650px" frameborder="0" scrolling="no" title="AIAA Google Calendar"></iframe>
												</article>

										</div>	
									</div>
								</div>
								<p>
								<iframe src="{{ events.sheetUrl }}" width="100%" height="565px" frameborder="0"></iframe>
								</p>
							</div>
						</div>
					</div>
				</div>
			