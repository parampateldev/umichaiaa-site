---
layout: layout.njk
permalink: /officers.html
title: "Michigan AIAA: About Us"
pageKey: about
css: /assets-about/officers.css
bodyClass: homepage subpage page-about
navCurrent: about
eleventyComputed:
  heroImageUrl: "{{ about.heroImage | safe }}"
gallery: ["t_stage","t_conf","t_ice"]
---
<div id="main-wrapper">
                    <div class="wrapper style2">
                        <div class="inner">
                            <div class="container">
                                <div id="content">

                                    <!-- Content -->

                                        <article>
{{ about.introHtml | safe }}
</article>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="wrapper style3">
                        <div class="inner">
                            <div class="container">
                                <div class="row">
                                    <div class="col-8 col-12-medium">

                                        <!-- Article list -->
                                            <section class="box article-list">
                                                <h2 class="icon fa-file-text-o">{{ about.officersHeading }}</h2>

                                                {% for o in about.officers %}
<article class="box excerpt officer-row">
<a class="image left"><img src="{{ o.photo }}" alt="{{ o.name }}"></a>
<div>
<header>
<span class="date">{{ o.name }}</span>
<h3><a>{{ o.role }}</a></h3>
</header>
{% if o.year or o.major %}<p class="officer-line">{% if o.year %}<span class="yr">{{ o.year }}</span>{% endif %}{% if o.year and o.major %} in {% endif %}{% if o.major %}<span class="mj">{{ o.major }}</span>{% endif %}</p>{% endif %}
{% if o.minor %}<p class="officer-line">Minor{% if " & " in o.minor %}s{% endif %} in <span class="mj">{{ o.minor }}</span></p>{% endif %}
{% if o.bio %}<p>{{ o.bio }}</p>{% endif %}
</div>
</article>
{% endfor %}
											</section>
									</div>
									<div class="col-4 col-12-medium">

                                        <!-- MEMBER SPOTLIGHT -->
                                            <section class="box spotlight">
                                                <h2 class="icon fa-file-text-o">{{ about.spotlightHeading }}</h2>
												<article class="spot-card">
<div class="spot-empty" role="img" aria-label="No member of the month at the moment"></div>
<h3>{{ about.spotlightName }}</h3>
<p class="spot-date">{{ about.spotlightDate }}</p>
{% for line in about.spotlightText %}<p>{{ line }}</p>{% endfor %}
</article>
											</section>
                                        <!-- END EDITABLE SECTION -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            