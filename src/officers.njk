---
layout: layout.njk
permalink: /officers.html
title: "Michigan AIAA: About Us"
pageKey: about
css: /assets-about/officers.css
bodyClass: homepage subpage page-about
navCurrent: about
eleventyComputed:
  heroImageUrl: "{{ about.heroImage | safe }}"
---
<div id="main-wrapper">
                    <div class="wrapper style2">
                        <div class="inner">
                            <div class="container">
                                <div id="content">

                                    <!-- Content -->

                                        <article>
{{ about.introHtml | safe }}
</article>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="wrapper style3">
                        <div class="inner">
                            <div class="container">
                                <div class="row">
                                    <div class="col-8 col-12-medium">

                                        <!-- Article list -->
                                            <section class="box article-list">
                                                <h2 class="icon fa-file-text-o">{{ about.officersHeading }}</h2>

                                                <div class="officer-grid">
{% for o in about.officers %}
<article class="box excerpt officer-card">
<div class="officer-photo"><img src="{{ o.photo }}" alt="{{ o.name }}"></div>
<div class="officer-name">{{ o.name }}</div>
<div class="officer-role">{{ o.role }}</div>
<div class="officer-facts">
{% if o.year or o.major %}<div class="fact">{% if o.year %}<span class="yr">{{ o.year }}</span>{% endif %}{% if o.year and o.major %} in {% endif %}{% if o.major %}<span class="mj">{{ o.major }}</span>{% endif %}</div>{% endif %}
{% if o.minor %}<div class="fact">Minor{% if " & " in o.minor %}s{% endif %} in <span class="mj">{{ o.minor }}</span></div>{% endif %}
</div>
{% if o.bio %}<p class="officer-bio">{{ o.bio }}</p>{% endif %}
</article>
{% endfor %}
</div>
											</section>
									</div>
									<div class="col-4 col-12-medium">

                                        <!-- MEMBER SPOTLIGHT -->
                                            <section class="box spotlight">
                                                <h2 class="icon fa-file-text-o">{{ about.spotlightHeading }}</h2>
												<article>
													<a href="#" class="image featured"><img src="{{ about.spotlightImage }}" alt=""></a>
													<header>
														<h3><a href="#">{{ about.spotlightName }}</a></h3>
														<p>{{ about.spotlightDate }}</p>
													</header>
													{% for line in about.spotlightText %}<p>{{ line }}</p>{% endfor %}
												</article>
											</section>
                                        <!-- END EDITABLE SECTION -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            